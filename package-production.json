{
  "name": "whatsapp-crm-system",
  "version": "1.0.0",
  "description": "Sistema CRM con integración WhatsApp e IA",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^0.10.4",
    "@vitejs/plugin-react": "^4.2.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.30.0",
    "drizzle-kit": "^0.21.0",
    "esbuild": "^0.20.2",
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.0",
    "whatsapp-web.js": "^1.23.0",
    "drizzle-zod": "^0.5.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "ai",
    "automation",
    "customer-service"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}